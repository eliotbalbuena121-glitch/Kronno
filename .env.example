# ============================================
# CONFIGURACIÓN KRONO 2026
# ============================================
# 
# INSTRUCCIONES:
# 1. DESARROLLO LOCAL: copia este archivo a .env y completa con tus datos
# 2. RENDER/CLOUD: agrega estas variables en el panel (sin crear .env)
#
# ============================================

# ============================================
# BASE DE DATOS - DESARROLLO LOCAL (XAMPP)
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kronno2026
DB_USER=root
DB_PASS=

# ============================================
# BASE DE DATOS - RENDER (EJEMPLO)
# ============================================
# DB_HOST=mysql-instance.c.aivencloud.com
# DB_PORT=26962
# DB_NAME=kronno2026_db
# DB_USER=avnadmin
# DB_PASS=tu_contraseña_segura_aqui

# ============================================
# CONFIGURACIÓN DE APP
# ============================================
# Valores: development o production
APP_ENV=development

# ============================================
# DEBUG (solo en desarrollo)
# ============================================
DEBUG=true

# ============================================
# DOMINIO (para links absolutos)
# ============================================
# LOCAL
APP_URL=http://localhost/KRONNO

# RENDER
# APP_URL=https://tu-app.onrender.com

# ============================================
# SESIÓN
# ============================================
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_HTTPONLY=true

# ============================================
# EMAIL (opcional, para futuro)
# ============================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_email@gmail.com
MAIL_PASS=tu_app_password
